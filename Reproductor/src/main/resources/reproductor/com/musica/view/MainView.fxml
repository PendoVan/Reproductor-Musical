<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="border-pane" stylesheets="@app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="reproductor.com.musica.controller.PlayerController">
            
  <!-- HEADER TOOLBAR -->
  <top>
    <ToolBar styleClass="tool-bar">
      <!-- File Operations -->
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Button fx:id="btnOpen" onAction="#onOpenFile" styleClass="button, animated-button" text="Abrir Archivos" />
        <MenuButton styleClass="button" text="Biblioteca">
          <items>
            <MenuItem text="Importar Carpeta" />
            <MenuItem text="Escanear Biblioteca" />
            <MenuItem text="Configuración" />
          </items>
        </MenuButton>
        <Button fx:id="btnSearch" onAction="#onSearchClicked" styleClass="button, animated-button" text="Buscar Online" />
      </HBox>
      
      <Region HBox.hgrow="ALWAYS" />
      
      <!-- Playback Mode Controls -->
      <HBox alignment="CENTER_RIGHT" spacing="8">
        <Button fx:id="btnShuffle" onAction="#onShuffleClicked" styleClass="button, mode-button" text="🔀 Aleatorio" />
        <Button fx:id="btnRepeat" onAction="#onRepeatClicked" styleClass="button, mode-button" text="🔁 Repetir" />
        <MenuButton styleClass="button" text="Vista">
          <items>
            <MenuItem text="Lista Compacta" />
            <MenuItem text="Lista Detallada" />
            <MenuItem text="Visualizador" />
          </items>
        </MenuButton>
      </HBox>
    </ToolBar>
  </top>

  <!-- MAIN CONTENT AREA -->
  <center>
    <VBox spacing="16" styleClass="center-panel">
      <padding>
        <Insets topRightBottomLeft="20" />
      </padding>

      <!-- NOW PLAYING SECTION -->
      <VBox alignment="CENTER" spacing="12">
        <Label fx:id="trackLabel" styleClass="track-title" text="🎵 Selecciona una canción para reproducir" />
        <Label fx:id="statusLabel" styleClass="status-indicator" text="⏹️ Detenido" />
        
        <!-- Progress Control -->
        <VBox alignment="CENTER" spacing="8">
          <Slider fx:id="progressSlider" prefWidth="600" styleClass="slider" />
          <HBox alignment="CENTER" spacing="16">
            <Label fx:id="currentTime" styleClass="time-label" text="00:00" />
            <Label styleClass="time-label" text="•" />
            <Label fx:id="totalTime" styleClass="time-label" text="00:00" />
          </HBox>
        </VBox>
      </VBox>

      <!-- TRANSPORT CONTROLS -->
      <HBox alignment="CENTER" spacing="16">
        <Button fx:id="btnPrev" onAction="#onPrev" prefHeight="50" prefWidth="71.0" styleClass="button, animated-button" text="⏮" textAlignment="CENTER" wrapText="true" />
        <Button fx:id="btnPlay" maxWidth="92.0" onAction="#onPlay" prefHeight="60" prefWidth="92.0" styleClass="button, animated-button" text="▶" textAlignment="CENTER" wrapText="true" />
        <Button fx:id="btnPause" onAction="#onPause" prefHeight="60" prefWidth="69.0" styleClass="button, animated-button" text="⏸" textAlignment="CENTER" wrapText="true" />
        <Button fx:id="btnStop" onAction="#onStop" prefHeight="50" prefWidth="50.0" styleClass="button, animated-button" text="⏹" textAlignment="CENTER" wrapText="true" />
        <Button fx:id="btnNext" onAction="#onNext" prefHeight="50" prefWidth="72.0" styleClass="button, animated-button" text="⏭" textAlignment="CENTER" wrapText="true" />
      </HBox>

      <!-- VOLUME CONTROL SECTION -->
      <HBox alignment="CENTER" spacing="12">
        <Label styleClass="label" text="Volumen:" />
        <Slider fx:id="volumeSlider" prefWidth="200" styleClass="slider" />
        <CheckBox fx:id="muteCheck" onAction="#onToggleMute" styleClass="check-box" text="Silenciar" />
      </HBox>

      <!-- PLAYLIST SECTION -->
      <VBox spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
          <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="label" text="Lista de Reproducción" />
          <Region HBox.hgrow="ALWAYS" />
          <Button styleClass="button" text="Limpiar Lista" />
          <Button styleClass="button" text="Guardar Lista" />
        </HBox>
        
        <ListView fx:id="playlistView" prefHeight="300" styleClass="list-view" VBox.vgrow="ALWAYS" />
      </VBox>
    </VBox>
  </center>

  <!-- STATUS BAR (BOTTOM) -->
  <bottom>
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: rgba(26, 26, 46, 0.8); -fx-padding: 8 16;">
      <Label fx:id="statusLabel" style="-fx-font-size: 12px;" styleClass="label" text="Listo" />
      <Region HBox.hgrow="ALWAYS" />
      <Label fx:id="trackCountLabel" style="-fx-font-size: 12px;" styleClass="label" text="0 canciones" />
      <Separator orientation="VERTICAL" />
      <Label fx:id="totalDurationLabel" styleClass="time-label" text="00:00:00" />
    </HBox>
  </bottom>

</BorderPane>
