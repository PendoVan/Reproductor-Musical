<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="reproductor.com.musica.controller.PlayerController"
            stylesheets="@dark-theme.css"
            fx:id="root">

  <!-- HEADER BAR -->
  <top>
    <HBox fx:id="headerBar" styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
      <padding>
        <Insets topRightBottomLeft="12" />
      </padding>
      
      <!-- Left Side Controls -->
      <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="openFilesButton" onAction="#onOpenFile" 
                text="Abrir archivos" styleClass="control-button" />
        <Button fx:id="libraryButton" 
                text="Biblioteca" styleClass="control-button" />
      </HBox>
      
      <!-- Spacer -->
      <Region HBox.hgrow="ALWAYS" />
      
      <!-- Right Side Controls -->
      <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="searchButton" onAction="#onSearchClicked"
                text="🔍 Buscar" styleClass="control-button" />
        <Button fx:id="shuffleToggle" onAction="#onShuffleClicked"
                text="🔀 Aleatorio" styleClass="toggle-button" />
        <Button fx:id="repeatToggle" onAction="#onRepeatClicked"
                text="🔁 Repetir" styleClass="toggle-button" />
      </HBox>
    </HBox>
  </top>

  <!-- MAIN CONTENT -->
  <center>
    <HBox fx:id="mainContent" styleClass="main-content" spacing="24">
      <padding>
        <Insets topRightBottomLeft="24" />
      </padding>
      
      <!-- LEFT COLUMN - Now Playing -->
      <VBox fx:id="nowPlayingSection" styleClass="now-playing-section" 
            spacing="24" alignment="TOP_CENTER" prefWidth="400">
        
        <!-- Album Cover -->
        <VBox alignment="CENTER">
          <ImageView fx:id="albumCover" fitWidth="250" fitHeight="250" 
                     styleClass="album-cover" preserveRatio="true">
            <!-- Placeholder rectangle when no image -->
            <Rectangle width="250" height="250" styleClass="album-placeholder" />
          </ImageView>
        </VBox>
        
        <!-- Track Info -->
        <VBox spacing="8" alignment="CENTER">
          <Label fx:id="currentTrackLabel" text="Selecciona una canción"
                 styleClass="primary-text, track-title" wrapText="true" />
          <Label fx:id="currentArtistLabel" text="Artista desconocido"
                 styleClass="secondary-text, artist-name" />
          <Label fx:id="playbackStatusLabel" text="Detenido"
                 styleClass="status-text" />
        </VBox>
        
        <!-- Progress Section -->
        <VBox spacing="8" alignment="CENTER" prefWidth="300">
          <Slider fx:id="progressSlider" styleClass="progress-slider" 
                  prefWidth="300" />
          <HBox alignment="CENTER" spacing="8">
            <Label fx:id="currentTimeLabel" text="0:00" 
                   styleClass="secondary-text, time-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="totalTimeLabel" text="0:00" 
                   styleClass="secondary-text, time-label" />
          </HBox>
        </VBox>
        
        <!-- Transport Controls -->
        <HBox spacing="16" alignment="CENTER">
          <Button fx:id="prevButton" onAction="#onPrev" 
                  text="⏮" styleClass="transport-button" />
          <Button fx:id="rewindButton" 
                  text="⏪" styleClass="transport-button" />
          <Button fx:id="playButton" onAction="#onPlay" 
                  text="▶" styleClass="play-button" />
          <Button fx:id="pauseButton" onAction="#onPause" 
                  text="⏸" styleClass="transport-button" />
          <Button fx:id="stopButton" onAction="#onStop" 
                  text="⏹" styleClass="transport-button" />
          <Button fx:id="fastForwardButton" 
                  text="⏩" styleClass="transport-button" />
          <Button fx:id="nextButton" onAction="#onNext" 
                  text="⏭" styleClass="transport-button" />
        </HBox>
        
        <!-- Volume Control -->
        <HBox spacing="12" alignment="CENTER">
          <Label text="🔊" styleClass="secondary-text" />
          <Slider fx:id="volumeSlider" styleClass="volume-slider" 
                  prefWidth="150" min="0" max="1" value="0.7" />
          <CheckBox fx:id="muteCheckbox" onAction="#onToggleMute" 
                    text="Silenciar" styleClass="mute-checkbox" />
        </HBox>
      </VBox>
      
      <!-- RIGHT COLUMN - Playlist -->
      <VBox fx:id="playlistSection" styleClass="playlist-section" 
            spacing="16" HBox.hgrow="ALWAYS">
        
        <!-- Playlist Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
          <Label text="Lista de reproducción" 
                 styleClass="primary-text, section-title" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="playlistCountLabel" text="0 canciones" 
                 styleClass="secondary-text" />
        </HBox>
        
        <!-- Playlist -->
        <ListView fx:id="playlistView" styleClass="playlist" 
                  VBox.vgrow="ALWAYS" />
        
        <!-- Playlist Controls -->
        <HBox spacing="12" alignment="CENTER_RIGHT">
          <Button fx:id="clearPlaylistButton" 
                  text="Limpiar lista" styleClass="secondary-button" />
          <Button fx:id="savePlaylistButton" 
                  text="Guardar lista" styleClass="control-button" />
        </HBox>
      </VBox>
    </HBox>
  </center>

  <!-- STATUS BAR -->
  <bottom>
    <HBox fx:id="statusBar" styleClass="status-bar" alignment="CENTER_LEFT" spacing="16">
      <padding>
        <Insets topRightBottomLeft="8" />
      </padding>
      
      <!-- Left Status -->
      <Label fx:id="statusLabel" text="Listo" 
             styleClass="secondary-text" />
      
      <!-- Spacer -->
      <Region HBox.hgrow="ALWAYS" />
      
      <!-- Right Status -->
      <HBox spacing="16" alignment="CENTER_RIGHT">
        <Label fx:id="totalTracksLabel" text="0 canciones en lista" 
               styleClass="secondary-text" />
        <Separator orientation="VERTICAL" />
        <Label fx:id="totalDurationLabel" text="Duración total: 0:00" 
               styleClass="secondary-text" />
      </HBox>
    </HBox>
  </bottom>

</BorderPane>