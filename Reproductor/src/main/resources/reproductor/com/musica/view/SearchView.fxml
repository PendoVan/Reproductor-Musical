<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="reproductor.com.musica.controller.SearchController"
            fx:id="searchRoot" styleClass="border-pane" stylesheets="@app.css">

  <!-- SEARCH HEADER -->
  <top>
    <VBox spacing="16" styleClass="center-panel">
      <padding>
        <Insets topRightBottomLeft="20" />
      </padding>

      <!-- Search Title -->
      <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnBack"
                text="← Volver"
                styleClass="button, animated-button" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Búsqueda Online de Música"
               styleClass="label"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
      </HBox>

      <!-- Search Input -->
      <HBox spacing="12" alignment="CENTER">
        <TextField fx:id="searchField"
                   promptText="Buscar canciones, artistas, álbumes..."
                   prefWidth="500"
                   styleClass="search-field" />
        <Button fx:id="btnSearch"
                text="Buscar"
                styleClass="button, animated-button"
                prefWidth="100"
                onAction="#onSearchClicked" />
        <Button fx:id="btnClear"
                text="Limpiar"
                styleClass="button"
                onAction="#onClearClicked" />
      </HBox>

      <!-- Search Status -->
      <HBox spacing="12" alignment="CENTER_LEFT">
        <ProgressIndicator fx:id="searchProgress"
                           visible="false"
                           prefWidth="24" prefHeight="24" />
        <Label fx:id="searchStatusLabel"
               text="Ingresa un término de búsqueda para comenzar"
               styleClass="label"
               style="-fx-font-size: 14px;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="resultsCountLabel"
               text=""
               styleClass="label"
               style="-fx-font-size: 12px;" />
      </HBox>
    </VBox>
  </top>

  <!-- SEARCH RESULTS -->
  <center>
    <VBox spacing="16" styleClass="center-panel">
      <padding>
        <Insets topRightBottomLeft="20" />
      </padding>

      <!-- Results Header -->
      <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Resultados de Búsqueda"
               styleClass="label"
               style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSelectAll"
                text="Seleccionar Todo"
                styleClass="button"
                onAction="#onSelectAllClicked" />
        <Button fx:id="btnAddSelected"
                text="Agregar Seleccionados"
                styleClass="button, animated-button"
                onAction="#onAddToPlaylistClicked" />
      </HBox>

      <!-- Results Table -->
      <TableView fx:id="resultsTable"
                 VBox.vgrow="ALWAYS"
                 styleClass="results-table"
                 prefHeight="400">
        <columns>
          <TableColumn fx:id="titleColumn"
                       text="Título"
                       prefWidth="250" />
          <TableColumn fx:id="artistColumn"
                       text="Artista"
                       prefWidth="200" />
          <TableColumn fx:id="albumColumn"
                       text="Álbum"
                       prefWidth="200" />
          <TableColumn fx:id="durationColumn"
                       text="Duración"
                       prefWidth="80" />
          <TableColumn fx:id="qualityColumn"
                       text="Calidad"
                       prefWidth="80" />
          <TableColumn fx:id="actionsColumn"
                       text="Acciones"
                       prefWidth="120" />
        </columns>
      </TableView>
    </VBox>
  </center>

  <!-- STATUS BAR -->
  <bottom>
    <HBox spacing="16" alignment="CENTER_LEFT"
          style="-fx-background-color: rgba(26, 26, 46, 0.8); -fx-padding: 8 16;">
      <Label fx:id="searchFooterLabel"
             text="Utiliza términos específicos para mejores resultados"
             styleClass="label"
             style="-fx-font-size: 12px;" />
      <Region HBox.hgrow="ALWAYS" />
      <Label fx:id="connectionStatusLabel"
             text="Conectado"
             styleClass="label"
             style="-fx-font-size: 12px; -fx-text-fill: #06b6d4;" />
    </HBox>
  </bottom>

</BorderPane>
